# ============================================================================
#  SIRTA — contoh berkas .env untuk SERVER PRODUKSI
#  Salin menjadi  .env  di folder backend di server, lalu isi bagian bertanda  ← ISI
#  JANGAN pernah meng-commit berkas .env yang sudah terisi ke GitHub.
# ============================================================================

APP_NAME=SIRTA
APP_ENV=production
APP_KEY=                      # ← ISI: jalankan  php artisan key:generate --force
APP_DEBUG=false               # WAJIB false di produksi (true membocorkan isi kode & konfigurasi)
APP_URL=https://sirta.org     # ← ISI: alamat situs, memakai https

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Log harian agar berkas log tidak membesar tanpa batas; hanya catat peringatan ke atas.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database MySQL dari hPanel → Databases → Management.
# Di Hostinger, DB_HOST biasanya 127.0.0.1 atau localhost.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=                  # ← ISI: nama database (mis. u123456789_sirta)
DB_USERNAME=                  # ← ISI: pengguna database
DB_PASSWORD=                  # ← ISI: kata sandi database

# Penyimpanan sederhana berbasis berkas — tidak butuh tabel/antrean tambahan.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# SIRTA belum mengirim email; dibiarkan mencatat ke log.
MAIL_MAILER=log
